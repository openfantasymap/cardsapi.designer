# GitHub OAuth App client id (PUBLIC — safe to embed in the bundle; PKCE flow).
# Register an OAuth App at https://github.com/settings/developers and set its
# Authorization callback URL to <this-app-origin>/auth/callback.
VITE_GITHUB_CLIENT_ID=

# URL of the CardForge proxy (no trailing slash).
#
# The proxy is a small stateless service used for two things only:
#   - the OAuth token exchange (POST /auth/github/exchange) — GitHub's token
#     endpoint has no CORS and requires the client secret, which lives only on
#     the proxy, never in this bundle.
#   - optional remote PDF rendering (POST /render/pdf).
#
# All project data is read/written directly from the browser to GitHub using
# the signed-in user's token — it does NOT go through this URL.
#
# In local dev, requests fall back to /api on the same host if this is unset.
VITE_CARDFORGE_API_URL=https://your-cardforge-proxy.example.com
